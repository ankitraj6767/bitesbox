# ═══════════════════════════════════════════════════════════════════════════
# Bites Box — environment template
# Copy to `.env` (root, for tooling) and to the per-app locations noted below.
# NEVER commit real values. Service-role/secret keys must never reach a client.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (project: kqsbzafxntsksalchlgc) ──────────────────────────────
SUPABASE_PROJECT_REF=kqsbzafxntsksalchlgc
SUPABASE_URL=https://kqsbzafxntsksalchlgc.supabase.co
# Publishable (anon) key — safe for clients
SUPABASE_PUBLISHABLE_KEY=sb_publishable_i21MTIIoW7yoVtyIkhPO_w_QfJbFnsjf
# SERVER ONLY. Used by Edge Functions and admin server actions. Never in Flutter.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# Verifies Supabase-signed webhook/queue payloads
SUPABASE_JWT_SECRET=

# ─── Admin dashboard (apps/admin/.env.local) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://kqsbzafxntsksalchlgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_i21MTIIoW7yoVtyIkhPO_w_QfJbFnsjf
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Razorpay (server side only) ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Public key id is safe to expose to the checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Google Maps Platform ──────────────────────────────────────────────────
# Restricted per-platform keys for clients
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Unrestricted-by-IP server key for geocoding / distance matrix in Edge Functions
GOOGLE_MAPS_SERVER_KEY=

# ─── Firebase Cloud Messaging (HTTP v1) ────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Escape newlines as \n
FCM_PRIVATE_KEY=

# ─── OTP provider (abstraction — pick one) ─────────────────────────────────
# supported: msg91 | twilio | firebase | console (dev only)
OTP_PROVIDER=console
OTP_SENDER_ID=BITESB
OTP_TEMPLATE_ID=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─── Email provider ────────────────────────────────────────────────────────
# supported: resend | ses | smtp | console (dev only)
EMAIL_PROVIDER=console
EMAIL_FROM="Bites Box <orders@bitesbox.in>"
RESEND_API_KEY=

# ─── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ─── Platform behaviour ────────────────────────────────────────────────────
DEFAULT_BRANCH_CODE=BKP-01
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
